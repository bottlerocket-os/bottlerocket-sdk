#!/bin/bash

# A regular-path binary may carry the FIPS backend for runtime selection.
# Keep validating a supplied FIPS copy for legacy packaging.

set -euo pipefail
shopt -qs failglob

for opt in "$@"; do
   optarg="$(expr "${opt}" : '[^=]*=\(.*\)')"
   case "${opt}" in
      --target=*) TARGET="${optarg}" ;;
      --bindir=*) BINDIR="${optarg}" ;;
      --fips-bindir=*) FIPS_BINDIR="${optarg}" ;;
      --libexecdir=*) LIBEXECDIR="${optarg}" ;;
      --fips-libexecdir=*) FIPS_LIBEXECDIR="${optarg}" ;;
   esac
done

STRINGS="${TARGET}-strings"
BUILDROOT_BINDIR="${RPM_BUILD_ROOT}${BINDIR}"
BUILDROOT_FIPS_BINDIR="${RPM_BUILD_ROOT}${FIPS_BINDIR}"
BUILDROOT_LIBEXECDIR="${RPM_BUILD_ROOT}${LIBEXECDIR}"
BUILDROOT_FIPS_LIBEXECDIR="${RPM_BUILD_ROOT}${FIPS_LIBEXECDIR}"

scan_dirs=()
for dir in "${BUILDROOT_BINDIR}" "${BUILDROOT_LIBEXECDIR}"; do
  [ ! -d "${dir}" ] || scan_dirs+=("${dir}")
done

if [ "${#scan_dirs[@]}" -eq 0 ]; then
  echo "no binaries found, skipping FIPS check"
  exit 0
fi

is_rust_bin() {
  local bin output
  bin="${1:?}"
  output="$("${STRINGS}" "${bin}")" || {
    echo "${bin}: failed to read strings" >&2
    exit 1
  }
  grep -Fq -m1 -e 'rust_alloc' -e 'rust_begin' <<<"${output}"
}

uses_ring() {
  local bin output
  bin="${1:?}"
  output="$("${STRINGS}" "${bin}")" || {
    echo "${bin}: failed to read strings" >&2
    exit 1
  }
  grep -Fq -m1 '/ring' <<<"${output}"
}

uses_aws_lc_rs() {
  local bin output
  bin="${1:?}"
  output="$("${STRINGS}" "${bin}")" || {
    echo "${bin}: failed to read strings" >&2
    exit 1
  }
  grep -Fq -m1 'aws-lc-rs' <<<"${output}"
}

uses_aws_lc_fips_sys() {
  local bin output
  bin="${1:?}"
  output="$("${STRINGS}" "${bin}")" || {
    echo "${bin}: failed to read strings" >&2
    exit 1
  }
  grep -Fq -m1 'aws-lc-fips-sys' <<<"${output}"
}

check_rust_bin() {
  local b f
  b="${1:?}"
  f="${2:?}"

  if uses_aws_lc_rs "${b}"; then
    if [ -e "${f}" ] || [ -L "${f}" ]; then
      if [ ! -f "${f}" ] || [ ! -s "${f}" ]; then
        echo "${f} is not a nonempty regular FIPS binary" >&2
        (( miscompiled+=1 ))
      elif uses_aws_lc_fips_sys "${f}"; then
        echo "${b} uses aws-lc-rs and FIPS build found in ${f}"
        (( found+=1 ))
      else
        echo "${f} is built with standard aws-lc-rs rather than in FIPS mode" >&2
        (( miscompiled+=1 ))
      fi
    elif uses_aws_lc_fips_sys "${b}"; then
      echo "${b} uses aws-lc-rs with the FIPS backend"
      (( found+=1 ))
    else
      echo "${b} uses aws-lc-rs but no FIPS build found in ${f}" >&2
      (( not_found+=1 ))
    fi
  else
    if uses_ring "${b}"; then
      echo "${b} must use aws-lc-rs" >&2
      (( miscompiled+=1 ))
    fi
  fi
}

found=0
not_found=0
miscompiled=0
if ! binaries="$(find "${scan_dirs[@]}" -type f -executable)"; then
  echo "failed to scan binaries" >&2
  exit 1
fi

for b in ${binaries} ; do
  f="${b/${BUILDROOT_BINDIR}/${BUILDROOT_FIPS_BINDIR}}"
  f="${f/${BUILDROOT_LIBEXECDIR}/${BUILDROOT_FIPS_LIBEXECDIR}}"
  if is_rust_bin "${b}"; then
    check_rust_bin "${b}" "${f}"
  fi
done

if [ "${found}" -gt 0 ] ; then
  [ "${found}" -eq 1 ] && what="binary" || what="binaries"
  echo "Found ${found} ${what} with FIPS crypto support."
fi

if [ "${not_found}" -gt 0 ] ; then
  [ "${not_found}" -eq 1 ] && what="binary" || what="binaries"
  echo "Could not find ${not_found} ${what} built for FIPS." >&2
  exit 1
fi

if [ "${miscompiled}" -gt 0 ] ; then
  [ "${miscompiled}" -eq 1 ] && what="binary" || what="binaries"
  echo "Found ${miscompiled} ${what} using the wrong crypto." >&2
  exit 1
fi
