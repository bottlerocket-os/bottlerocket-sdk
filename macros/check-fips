#!/bin/bash

# Buildroot policy check for Rust binaries that link AWS-LC.
#
# Two packaging layouts are accepted:
#
#   paired         - a standard aws-lc-rs binary in ${bindir}/${libexecdir},
#                    plus a FIPS-backend copy at the matching path under the
#                    corresponding fips directory.
#   self-contained - a single binary in ${bindir}/${libexecdir} linked against
#                    aws-lc-fips-sys, with no separate FIPS copy.
#
# Everything else is a packaging error: standard crypto with no FIPS copy, a
# FIPS copy that is not FIPS-built, or any use of ring.
#
# TODO: a FIPS-backend binary that also ships a FIPS copy is allowed for now.
# core-kit ships this layout until it drops its separate FIPS copies. Reject
# it after that.

set -euo pipefail
shopt -qs failglob

usage() {
  echo "usage: ${0##*/} --target=TARGET --bindir=DIR --fips-bindir=DIR" \
       "--libexecdir=DIR --fips-libexecdir=DIR" >&2
  exit 1
}

for opt in "$@"; do
  optarg="${opt#*=}"
  case "${opt}" in
    --target=*) TARGET="${optarg}" ;;
    --bindir=*) BINDIR="${optarg}" ;;
    --fips-bindir=*) FIPS_BINDIR="${optarg}" ;;
    --libexecdir=*) LIBEXECDIR="${optarg}" ;;
    --fips-libexecdir=*) FIPS_LIBEXECDIR="${optarg}" ;;
    *) echo "${0##*/}: unknown option '${opt}'" >&2 ; usage ;;
  esac
done

for var in TARGET BINDIR FIPS_BINDIR LIBEXECDIR FIPS_LIBEXECDIR RPM_BUILD_ROOT ; do
  if [ -z "${!var:-}" ] ; then
    echo "${0##*/}: ${var} is not set" >&2
    usage
  fi
done

STRINGS="${TARGET}-strings"
if ! command -v "${STRINGS}" >/dev/null ; then
  echo "${0##*/}: ${STRINGS} not found" >&2
  exit 1
fi

# Ordered scan directories, and the FIPS directory each one pairs with.
scan_order=("${RPM_BUILD_ROOT}${BINDIR}" "${RPM_BUILD_ROOT}${LIBEXECDIR}")
declare -A fips_dir_for=(
  ["${RPM_BUILD_ROOT}${BINDIR}"]="${RPM_BUILD_ROOT}${FIPS_BINDIR}"
  ["${RPM_BUILD_ROOT}${LIBEXECDIR}"]="${RPM_BUILD_ROOT}${FIPS_LIBEXECDIR}"
)

scan_dirs=()
for dir in "${scan_order[@]}" ; do
  [ ! -d "${dir}" ] || scan_dirs+=("${dir}")
done

if [ "${#scan_dirs[@]}" -eq 0 ] ; then
  echo "no binaries found, skipping FIPS check"
  exit 0
fi

# Read the printable strings of a binary into the named variable. A failure
# here is fatal: silently treating it as "no crypto found" would pass the
# check vacuously.
read_symbols() {
  local -n _out="${1:?}"
  local bin="${2:?}"
  if ! _out="$("${STRINGS}" "${bin}")" ; then
    echo "${bin}: failed to read strings" >&2
    exit 1
  fi
}

paired=0
self=0
errors=0

check_binary() {
  local b="${1:?}" f="${2:?}"
  local b_sym f_sym b_fips

  read_symbols b_sym "${b}"

  # Not a Rust binary; the Rust crypto policy does not apply.
  grep -Fq -m1 -e 'rust_alloc' -e 'rust_begin' <<<"${b_sym}" || return 0

  # Any use of ring is an error; ring_core_ marks its compiled code.
  if grep -Fq -m1 -- 'ring_core_' <<<"${b_sym}" ; then
    echo "${b}: links ring, must use aws-lc-rs" >&2
    errors=$(( errors + 1 ))
  fi

  grep -Fq -m1 -- 'aws-lc-rs' <<<"${b_sym}" || return 0

  b_fips=0
  ! grep -Fq -m1 -- 'aws-lc-fips-sys' <<<"${b_sym}" || b_fips=1

  if [ ! -e "${f}" ] && [ ! -L "${f}" ] ; then
    # Self-contained layout: the shipped binary must carry the FIPS backend.
    if [ "${b_fips}" -eq 1 ] ; then
      echo "${b}: links aws-lc-fips-sys directly"
      self=$(( self + 1 ))
    else
      echo "${b}: links standard aws-lc-rs and has no FIPS build at ${f}" >&2
      errors=$(( errors + 1 ))
    fi
    return 0
  fi

  # Paired layout: the FIPS copy must be a FIPS build.
  if [ ! -f "${f}" ] || [ ! -s "${f}" ] ; then
    echo "${f}: not a non-empty regular file" >&2
    errors=$(( errors + 1 ))
    return 0
  fi

  read_symbols f_sym "${f}"
  if grep -Fq -m1 -- 'aws-lc-fips-sys' <<<"${f_sym}" ; then
    if [ "${b_fips}" -eq 1 ] ; then
      echo "${b}: links aws-lc-fips-sys, FIPS build also at ${f}"
    else
      echo "${b}: links standard aws-lc-rs, FIPS build at ${f}"
    fi
    paired=$(( paired + 1 ))
  else
    echo "${f}: links standard aws-lc-rs rather than aws-lc-fips-sys" >&2
    errors=$(( errors + 1 ))
  fi
}

found_list="$(mktemp)"
trap 'rm -f "${found_list}"' EXIT

if ! find "${scan_dirs[@]}" -type f -executable -print0 > "${found_list}" ; then
  echo "failed to scan ${scan_dirs[*]}" >&2
  exit 1
fi

bins=()
mapfile -t -d '' bins < "${found_list}"

for b in "${bins[@]}" ; do
  f=""
  for dir in "${scan_order[@]}" ; do
    if [[ "${b}" == "${dir}/"* ]] ; then
      f="${fips_dir_for["${dir}"]}/${b#"${dir}/"}"
      break
    fi
  done
  if [ -z "${f}" ] ; then
    echo "${b}: not under a scanned directory" >&2
    exit 1
  fi
  check_binary "${b}" "${f}"
done

if [ "$(( paired + self ))" -gt 0 ] ; then
  echo "Found $(( paired + self )) binaries built for FIPS" \
       "(${paired} paired, ${self} self-contained)."
fi

if [ "${errors}" -gt 0 ] ; then
  [ "${errors}" -eq 1 ] && what="error" || what="errors"
  echo "Found ${errors} FIPS packaging ${what}." >&2
  exit 1
fi
